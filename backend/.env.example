# Copy this file to .env and adjust as needed. Never commit .env.
# All settings use the LOANOPS_ prefix.

LOANOPS_APP_NAME=LoanOps Intelligence
LOANOPS_ENVIRONMENT=local

# Comma-separated list of browser origins allowed to call the API.
# The Vite dev server proxies /api, so this is only a fallback for
# direct browser-to-backend calls.
LOANOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI investigation (Ollama) -------------------------------------------
# Only the backend calls Ollama. Use any instruction-tuned model you have
# pulled; `ollama list` shows them. Run `python -m app.scripts.ai_check`
# after changing these.
LOANOPS_OLLAMA_BASE_URL=http://127.0.0.1:11434
LOANOPS_OLLAMA_MODEL=qwen2.5:7b
# Seconds to wait for one model response. CPU-only machines may need 300+.
LOANOPS_OLLAMA_TIMEOUT_SECONDS=180
# Total attempts; extra attempts are used only when output fails validation.
LOANOPS_OLLAMA_MAX_ATTEMPTS=2
LOANOPS_OLLAMA_TEMPERATURE=0
LOANOPS_OLLAMA_NUM_CTX=8192
