{
  "description": "Deterministic validation settings. Changing this file changes how exceptions are raised and graded; each validation run records this file's SHA-256.",
  "tolerances": {
    "amount_absolute": "0.01",
    "maturity_days": 0
  },
  "statuses": {
    "upstream_approved": ["APPROVED"],
